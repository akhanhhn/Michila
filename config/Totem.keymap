#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED
#define BASE 0
#define LOWER 1
#define RAISE 2
#define FN 3

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <1000>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <1000>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&caps_word {
};

&sk {
    quick-release;
    lazy;

    /delete-property/ ignore-modifiers;
};

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };

        dance_alt_capsWord: dance_alt_capsWord {
            compatible = "zmk,behavior-tap-dance";
            label = "DANCE_ALT_CAPSWORD";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT>, <&caps_word>;
        };

        laughing: laughing {
            compatible = "zmk,behavior-tap-dance";
            label = "LAUGHING";
            #binding-cells = <0>;
            bindings = <&hihi>, <&haha>;
        };

        raise_mouse_layer: raise_mouse_layer {
            compatible = "zmk,behavior-tap-dance";
            label = "RAISE_MOUSE_LAYER";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&none>, <&none>, <&to 4>;
        };

        holdTap: holdTap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <140>;
        };

        shift_capsWord_capsLocks: shift_capsWord_capsLocks {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CAPSWORD_CAPSLOCKS";
            #binding-cells = <0>;
            bindings = <&sk LEFT_SHIFT>, <&caps_word>, <&kp CAPS>;
        };

        dance_GUI_ctrlA: dance_GUI_ctrlA {
            compatible = "zmk,behavior-tap-dance";
            label = "DANCE_GUI_CTRLA";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI>, <&kp LC(A)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        doubleQuotes {
            bindings = <&kp RS(DQT)>;
            key-positions = <5 6>;
            layers = <0 2 1 3>;
        };

        LeftParenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <6 7>;
        };

        rightParenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
        };

        leftBracket {
            bindings = <&kp LBKT>;
            key-positions = <16 17>;
        };

        rightBracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <17 18>;
        };

        leftBrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <26 27>;
        };

        rightBrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <27 28>;
        };

        lessThan {
            bindings = <&kp LESS_THAN>;
            key-positions = <15 16>;
        };

        greaterThan {
            bindings = <&kp GREATER_THAN>;
            key-positions = <25 26>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <18 19>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <20 21>;
            layers = <0 1 2 3>;
        };

        delete {
            bindings = <&kp DEL>;
            key-positions = <21 22>;
            layers = <0 1 2 3>;
        };

        shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <22 23>;
            layers = <0 1 2 3>;
        };

        enter {
            bindings = <&kp RET>;
            key-positions = <24 13>;
            layers = <0 1 2 3>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
        };

        toLayer3 {
            bindings = <&to 3>;
            key-positions = <24 25>;
            layers = <0 1 2 3>;
        };
    };

    macros {
        notEqual: different {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EXCLAMATION &kp EQUAL>, <&macro_press>;

            label = "DIFFERENT";
        };

        toRightArrow: toRightArrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GREATER_THAN>, <&macro_press>;

            label = "TORIGHTARROW";
        };

        haha: haha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EQUAL &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR>;
            label = "HAHA";
        };

        hihi: hihi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp RPAR &kp RPAR &kp RPAR>;
            label = "HIHI";
        };

        yankInVim: yankInVim {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DQT &kp PLUS &kp Y>;
            label = "YANKINVIM";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp Q          &kp W             &kp E         &kp R      &mt LCTRL T       &mt RCTRL Y       &kp U    &kp I               &kp O                      &kp P
&kp A          &kp S             &kp D         &kp F      &mt LEFT_SHIFT G  &mt LEFT_SHIFT H  &kp J    &kp K               &kp L                      &kp SEMICOLON
&kp Z          &kp X             &kp C         &kp V      &kp B             &kp N             &kp M    &kp COMMA           &kp DOT                    &mt LEFT_ALT SLASH
&mt LCTRL TAB  &dance_GUI_ctrlA  &lt 1 ESCAPE  &kp SPACE  &mkp LCLK         &mkp RCLK         &kp RET  &raise_mouse_layer  &shift_capsWord_capsLocks  &kp BACKSPACE
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_LR>;
        };

        lower_layer {
            display-name = "Lower Layer";
            bindings = <
&kp F2           &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &kp SLASH     &kp N7                 &kp N8        &kp N9        &kp MINUS
&trans           &kp LEFT_ARROW  &kp DOWN        &kp UP_ARROW  &kp RIGHT        &kp ASTERISK  &kp NUMBER_4           &kp NUMBER_5  &kp NUMBER_6  &kp PLUS
&kp PRINTSCREEN  &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &kp COMMA     &kp NUMBER_1           &kp NUMBER_2  &kp NUMBER_3  &kp DOT
&mt RCTRL TAB    &kp LEFT_GUI    &trans          &kp SPACE     &trans           &trans        &mt RIGHT_SHIFT ENTER  &trans        &kp N0        &kp BACKSPACE
            >;

            sensor-bindings =
                <&inc_dec_kp DOWN UP_ARROW>,
                <&inc_dec_kp RIGHT LEFT>;
        };

        raise_layer {
            display-name = "Raise Layer";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET       &kp AMPERSAND  &kp ASTERISK  &kp GRAVE      &laughing
&notEqual        &toRightArrow  &trans    &yankInVim  &trans       &kp MINUS       &kp EQUAL      &kp SQT       &kp BACKSLASH  &kp LC(LA(DELETE))
&trans           &trans         &trans    &trans      &trans       &kp UNDERSCORE  &kp PLUS       &kp TILDE     &kp PIPE       &kp QUESTION
&trans           &trans         &trans    &trans      &trans       &trans          &trans         &trans        &trans         &kp LG(L)
            >;

            sensor-bindings =
                <&inc_dec_kp C_NEXT C_PREVIOUS>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        FN {
            bindings = <
&kp F1   &kp F2        &kp F3  &kp F4  &kp F5   &sk RCTRL       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans       &trans
&kp F6   &kp F7        &kp F8  &kp F9  &kp F10  &sk LEFT_SHIFT  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_MUTE   &trans
&kp F11  &kp F12       &trans  &trans  &trans   &trans          &kp C_PREVIOUS        &kp C_NEXT            &kp C_PAUSE  &sk LEFT_ALT
&trans   &sk LEFT_GUI  &trans  &trans  &trans   &trans          &trans                &trans                &trans       &to 0
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>,
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        mouse {
            bindings = <
&mkp MCLK  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP     &msc SCRL_RIGHT  &none     &none      &none      &none      &none
&mkp MB5   &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &kp HOME         &mkp MB5  &mkp LCLK  &mkp MCLK  &mkp RCLK  &none
&mkp MB4   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp END          &mkp MB4  &none      &none      &none      &none
&trans     &trans          &trans          &trans           &trans           &trans    &trans     &trans     &trans     &to 0
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
