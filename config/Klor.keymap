#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 300   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <3000>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <1000>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt { flavor = "tap-preferred"; };

&lt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&sk {
    quick-release;
    lazy;
};

/ {
    behaviors {
        shiftSticky: shiftSticky {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFTSTICKY";
            #binding-cells = <0>;
            bindings = <&sk LEFT_SHIFT>;
        };

        GUI_ctrlA: GUI_ctrlA {
            compatible = "zmk,behavior-tap-dance";
            label = "GUI_CTRLA";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI>, <&kp LC(A)>;
        };

        laughing: laughing {
            compatible = "zmk,behavior-tap-dance";
            label = "LAUGHING";
            #binding-cells = <0>;
            bindings = <&hihi>, <&haha>;
        };

        lower_ctrlC: lower_ctrlC {
            compatible = "zmk,behavior-tap-dance";
            label = "LOWER_CTRLC";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&kp LC(C)>;
        };

        ctrl_ctrlV: ctrl_ctrlV {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRL_CTRLV";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&kp LC(V)>;
        };

        mo_to_FN: mo_to_FN {
            compatible = "zmk,behavior-tap-dance";
            label = "MO_TO_FN";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&to 3>;
        };

        mo_to_Mouse: mo_to_Mouse {
            compatible = "zmk,behavior-tap-dance";
            label = "MO_TO_MOUSE";
            #binding-cells = <0>;
            bindings = <&mo 4>, <&to 4>;
        };

        haizz_huhu: haizz_huhu {
            compatible = "zmk,behavior-tap-dance";
            label = "HAIZZ_HUHU";
            #binding-cells = <0>;
            bindings = <&haizzzz>, <&huhu>;
        };

        GUIL_CtrlAltDel: GUIL_CtrlAltDel {
            compatible = "zmk,behavior-tap-dance";
            label = "GUIL_CTRLALTDEL";
            #binding-cells = <0>;
            bindings = <&kp LG(L)>, <&kp LC(LA(DELETE))>;
        };

        LALT_CtrlShift: LALT_CtrlShift {
            compatible = "zmk,behavior-tap-dance";
            label = "LALT_CTRLSHIFT";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT>, <&kp LC(LEFT_SHIFT)>;
        };

        https_http: https_http {
            compatible = "zmk,behavior-tap-dance";
            label = "HTTPS_HTTP";
            #binding-cells = <0>;
            bindings = <&https>, <&http>;
        };
    };

    combos {
        compatible = "zmk,combos";

        doubleQuotes {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <6 8>;
        };

        leftParenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <6 7>;
        };

        rightParenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
        };

        leftBracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <17 18>;
        };

        rightBracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 19>;
        };

        leftBrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <29 30>;
        };

        rightBrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <30 31>;
        };

        lessThan {
            bindings = <&kp LESS_THAN>;
            key-positions = <17 19>;
        };

        greaterThan {
            bindings = <&kp GREATER_THAN>;
            key-positions = <29 31>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <19 20>;
        };

        backSpace {
            bindings = <&kp BACKSPACE>;
            key-positions = <23 24>;
            layers = <0 1 2 3>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <24 25>;
            layers = <0 1 2 3>;
        };

        shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <25 26>;
            layers = <0 1 2 3>;
        };

        return {
            bindings = <&kp RET>;
            key-positions = <14 27>;
            layers = <0 1 2 3>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <13 14>;
            layers = <0 1 2 3>;
        };

        Caps_Lock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <4 5>;
        };

        caps_Word {
            bindings = <&caps_word>;
            key-positions = <15 16>;
        };
    };

    macros {
        hihi: hihi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp COLON &kp RPAR &kp RPAR &kp RPAR>;
            label = "HIHI";
        };

        yankInVim: yankInVim {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DQT &kp PLUS &kp Y>;
            label = "YANKINVIM";
        };

        https: https {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp H &kp T &kp T &kp P &kp S &kp COLON &kp FSLH &kp FSLH>;
            label = "HTTPS";
        };

        notEqual: notEqual {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EXCL &kp EQUAL>;
            label = "NOTEQUAL";
        };

        rightArrow: rightArrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp MINUS &kp GT>;
            label = "RIGHTARROW";
        };

        haha: haha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EQUAL &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR>;
            label = "HAHA";
        };

        huhu: huhu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp COLON &kp LPAR &kp LPAR &kp LPAR &kp LPAR>;
            label = "HUHU";
        };

        haizzzz: haizzzz {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EQUAL &kp DOT &kp EQUAL>;
            label = "HAIZZZZ";
        };

        http: http {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp H &kp T &kp T &kp P &kp COLON &kp FSLH &kp FSLH>;
            label = "HTTP";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //            RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
        //    RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        //    RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
        //                    RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)

        default_layer {
            display-name = "Default Layer";
            bindings = <
             &kp Q  &kp W       &kp E         &kp R      &kp T      &kp Y         &kp U       &kp I      &kp O         &kp P
&kp ESCAPE   &kp A  &kp S       &kp D         &kp F      &kp G      &kp H         &kp J       &kp K      &kp L         &kp SEMICOLON  &kp BACKSPACE
&ctrl_ctrlV  &kp Z  &kp X       &kp C         &kp V      &kp B      &kp N         &kp M       &kp COMMA  &kp DOT       &kp FSLH       &LALT_CtrlShift
                    &GUI_ctrlA  &lower_ctrlC  &kp SPACE  &mo_to_FN  &mo_to_Mouse  &kp RETURN  &mo 2      &shiftSticky
            >;
        };

        lower_layer {
            display-name = "Lower Layer";
            bindings = <
        &trans           &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &kp SLASH     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS
&trans  &trans           &kp LEFT_ARROW  &kp DOWN        &kp UP_ARROW  &kp RIGHT        &kp ASTERISK  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS    &trans
&trans  &kp PRINTSCREEN  &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &kp COMMA     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &trans
                         &trans          &trans          &trans        &trans           &trans        &trans        &trans        &kp NUMBER_0
            >;
        };

        raise_layer {
            display-name = "Raise Layer";
            bindings = <
        &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET       &kp AMPERSAND  &kp ASTERISK  &kp GRAVE      &laughing
&trans  &notEqual        &rightArrow  &trans    &yankInVim  &https_http  &kp MINUS       &kp EQUAL      &kp SQT       &kp BACKSLASH  &haizz_huhu   &trans
&trans  &trans           &trans       &trans    &trans      &trans       &kp UNDERSCORE  &kp PLUS       &kp TILDE     &kp PIPE       &kp QUESTION  &GUIL_CtrlAltDel
                         &trans       &trans    &trans      &trans       &trans          &trans         &trans        &trans
            >;
        };

        FN {
            bindings = <
        &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3   &bt BT_DISC 4
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3    &bt BT_SEL 4   &to 0
&trans  &kp F11  &kp F12  &trans  &trans  &trans   &bt BT_CLR     &bt BT_NXT     &bt BT_PRV     &bt BT_CLR_ALL  &trans         &trans
                 &trans   &trans  &trans  &trans   &trans         &trans         &trans         &trans
            >;
        };

        mouse_layer {
            bindings = <
        &mkp MCLK  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP     &msc SCRL_RIGHT  &kp C_VOLUME_UP  &trans     &trans  &trans  &trans
&trans  &mkp MB5   &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &kp HOME         &kp C_VOL_DN     &mkp LCLK  &trans  &trans  &trans  &to 0
&trans  &mkp MB4   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp END          &kp K_MUTE       &trans     &trans  &trans  &trans  &trans
                   &trans          &trans          &trans           &bootloader      &trans           &trans     &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
