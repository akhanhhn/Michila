#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 200   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <3000>;       // 300
    delay-ms = <0>;                   // 0
    trigger-period-ms = <1>;
};

&mmv {
    time-to-max-speed-ms = <1000>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt { flavor = "tap-preferred"; };

&lt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&sk {
    quick-release;
    lazy;

    /delete-property/ ignore-modifiers;
};

/ {
    behaviors {
        shift_capsword_capslock: shift_capsword_capslock {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CAPSWORD_CAPSLOCK";
            #binding-cells = <0>;
            bindings = <&sk LEFT_SHIFT>, <&caps_word>, <&kp CAPSLOCK>;
        };

        lower_FN: lower_FN {
            compatible = "zmk,behavior-tap-dance";
            label = "LOWER_FN";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&to 3>;
        };

        raise_mouse: raise_mouse {
            compatible = "zmk,behavior-tap-dance";
            label = "RAISE_MOUSE";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&to 4>;
        };

        ctrlA_ctrlJ_GUI_: ctrlA_ctrlJ_GUI_ {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRLA_CTRLJ_GUI_";
            #binding-cells = <0>;
            bindings = <&mt LEFT_GUI LC(A)>, <&kp LC(J)>;
        };

        laughing: laughing {
            compatible = "zmk,behavior-tap-dance";
            label = "LAUGHING";
            #binding-cells = <0>;
            bindings = <&hihi>, <&haha>;
        };

        lower_ctrlC: lower_ctrlC {
            compatible = "zmk,behavior-tap-dance";
            label = "LOWER_CTRLC";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&kp LC(C)>;
        };

        ctrlC_ctrlV_ctrl_: ctrlC_ctrlV_ctrl_ {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRLC_CTRLV_CTRL_";
            #binding-cells = <0>;
            bindings = <&mt LCTRL LC(C)>, <&kp LC(V)>;
        };

        mo_to_FN: mo_to_FN {
            compatible = "zmk,behavior-tap-dance";
            label = "MO_TO_FN";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&to 3>;
        };

        mo_to_MOUSE: mo_to_MOUSE {
            compatible = "zmk,behavior-tap-dance";
            label = "MO_TO_MOUSE";
            #binding-cells = <0>;
            bindings = <&mo 4>, <&to 4>;
        };
    };

    combos {
        compatible = "zmk,combos";

        doubleQuotes {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <5 6>;
            layers = <0 1 2 3>;
        };

        leftParenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <6 7>;
            layers = <0 1 2 3>;
        };

        rightParenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
            layers = <0 1 2 3>;
        };

        leftBracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <17 18>;
            layers = <0 1 2 3>;
        };

        rightBracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 19>;
            layers = <0 1 2 3>;
        };

        leftBrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <29 30>;
            layers = <0 1 2 3>;
        };

        rightBrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <30 31>;
            layers = <0 1 2 3>;
        };

        lessThan {
            bindings = <&kp LESS_THAN>;
            key-positions = <16 17>;
            layers = <0 1 2 3>;
        };

        greaterThan {
            bindings = <&kp GREATER_THAN>;
            key-positions = <28 29>;
            layers = <0 1 2 3>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <19 20>;
            layers = <0 1 2 3>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <23 24>;
            layers = <0 1 2 3>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <24 25>;
            layers = <0 1 2 3>;
        };

        shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <25 26>;
            layers = <0 1 2 3>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <14 27>;
            layers = <0 1 2 3>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <13 14>;
        };
    };

    macros {
        hihi: hihi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp COLON &kp RPAR &kp RPAR &kp RPAR>;
            label = "HIHI";
        };

        yankInVim: yankInVim {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DQT &kp PLUS &kp Y>;
            label = "YANKINVIM";
        };

        https: https {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp H &kp T &kp T &kp P &kp S &kp COLON &kp FSLH &kp FSLH>;
            label = "HTTPS";
        };

        notEqual: notEqual {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EXCL &kp EQUAL>;
            label = "NOTEQUAL";
        };

        toRightArrow: toRightArrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp MINUS &kp GT>;
            label = "TORIGHTARROW";
        };

        haha: haha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EQUAL &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR>;
            label = "HAHA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //            RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
        //    RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        //    RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
        //                    RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)

        default_layer {
            display-name = "Default Layer";
            bindings = <
                    &kp Q  &kp W              &kp E  &kp R      &kp T      &kp Y         &kp U      &kp I      &kp O                     &kp P
&kp ESCAPE          &kp A  &kp S              &kp D  &kp F      &kp G      &kp H         &kp J      &kp K      &kp L                     &kp SEMI   &kp BACKSPACE
&ctrlC_ctrlV_ctrl_  &kp Z  &kp X              &kp C  &kp V      &kp B      &kp N         &kp M      &kp COMMA  &kp DOT                   &kp SLASH  &kp LEFT_ALT
                           &ctrlA_ctrlJ_GUI_  &mo 1  &kp SPACE  &mo_to_FN  &mo_to_MOUSE  &kp ENTER  &mo 2      &shift_capsword_capslock
            >;
        };

        lower_layer {
            display-name = "Lower Layer";
            bindings = <
                &trans           &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &kp SLASH     &kp N7        &kp N8        &kp N9        &kp MINUS
&kp LEFT_SHIFT  &trans           &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT        &kp ASTERISK  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS    &kp BACKSPACE
&kp LCTRL       &kp PRINTSCREEN  &kp HOME        &kp PAGE_DOWN   &kp PG_UP     &kp END          &kp COMMA     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &kp LEFT_ALT
                                 &kp LEFT_GUI    &trans          &kp SPACE     &trans           &trans        &kp RET       &trans        &kp NUMBER_0
            >;
        };

        raise_layer {
            display-name = "Raise Layer";
            bindings = <
        &kp EXCLAMATION  &kp AT_SIGN    &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET       &kp AMPERSAND  &kp ASTERISK  &kp GRAVE      &laughing
&trans  &notEqual        &toRightArrow  &trans    &yankInVim  &https       &kp MINUS       &kp EQUAL      &kp SQT       &kp BACKSLASH  &trans        &kp LC(LA(DEL))
&trans  &trans           &trans         &trans    &trans      &trans       &kp UNDERSCORE  &kp PLUS       &kp TILDE     &kp PIPE       &kp QUESTION  &kp LG(L)
                         &trans         &trans    &trans      &trans       &trans          &trans         &trans        &trans
            >;
        };

        FN {
            bindings = <
           &kp F1   &kp F2        &kp F3  &kp F4  &kp F5   &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3   &bt BT_DISC 4
&trans     &kp F6   &kp F7        &kp F8  &kp F9  &kp F10  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3    &bt BT_SEL 4   &to 0
&kp LCTRL  &kp F11  &kp F12       &trans  &trans  &trans   &bt BT_CLR     &bt BT_NXT     &bt BT_PRV     &bt BT_CLR_ALL  &trans         &kp LEFT_ALT
                    &kp LEFT_GUI  &trans  &trans  &trans   &trans         &trans         &trans         &kp LEFT_SHIFT
            >;
        };

        mouse {
            bindings = <
             &mkp MCLK  &msc SCRL_LEFT     &msc SCRL_DOWN  &msc SCRL_UP     &msc SCRL_RIGHT  &kp C_VOL_UP       &trans     &trans  &trans          &trans
&bootloader  &mkp MB5   &mkp LCLK          &mmv MOVE_UP    &mkp RCLK        &kp HOME         &kp C_VOLUME_DOWN  &mkp LCLK  &trans  &trans          &trans  &to 0
&kp LCTRL    &mkp MB4   &mmv MOVE_LEFT     &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp END          &kp K_MUTE         &trans     &trans  &trans          &trans  &kp LEFT_ALT
                        &ctrlA_ctrlJ_GUI_  &trans          &trans           &trans           &trans             &trans     &trans  &kp LEFT_SHIFT
            >;
        };

        layer_5 {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
