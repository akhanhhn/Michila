#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
};

&lt { tapping-term-ms = <300>; };

/ {
    behaviors {
        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        shift_capsword_capslock: shift_capsword_capslock {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CAPSWORD_CAPSLOCK";
            #binding-cells = <0>;
            bindings = <&kt LEFT_SHIFT>, <&caps_word>, <&kp CAPSLOCK>;
        };
    };

    combos {
        compatible = "zmk,combos";

        doubleQuotes {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <5 6>;
        };

        leftParenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <6 7>;
        };

        rightParenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
        };

        leftBracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <17 18>;
        };

        rightBracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 19>;
        };

        leftBrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <29 30>;
        };

        rightBrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <30 31>;
        };

        lessThan {
            bindings = <&kp LESS_THAN>;
            key-positions = <16 17>;
        };

        greaterThan {
            bindings = <&kp GREATER_THAN>;
            key-positions = <28 29>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <19 20>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <23 24>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <24 25>;
        };

        shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <25 26>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <14 27>;
        };
    };

    macros {
        hihi: haha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp COLON &kp RPAR &kp RPAR &kp RPAR>;
            label = "HAHA";
        };

        yankInVim: yankInVim {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DQT &kp PLUS &kp Y>;
            label = "YANKINVIM";
        };

        https: https {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp H &kp T &kp T &kp P &kp S &kp COLON &kp FSLH &kp FSLH>;
            label = "HTTPS";
        };

        notEqual: notEqual {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EXCL &kp EQUAL>;
            label = "NOTEQUAL";
        };

        toRightArrow: toRightArrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp MINUS &kp GT>;
            label = "TORIGHTARROW";
        };

        haha: haha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp EQUAL &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR &kp RPAR>;
            label = "HAHA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //            RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
        //    RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        //    RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
        //                    RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)

        default_layer {
            display-name = "Default Layer";
            bindings = <
               &kp Q  &kp W         &kp E         &kp R      &kp T        &kp Y            &kp U      &kp I      &kp O                     &kp P
&kp LC(A)      &kp A  &kp S         &kp D         &kp F      &kp G        &kp H            &kp J      &kp K      &kp L                     &kp SEMI            &kp LEFT
&mt LCTRL TAB  &kp Z  &kp X         &kp C         &kp V      &kp B        &kp N            &kp M      &kp COMMA  &kp DOT                   &mt LEFT_ALT SLASH  &kp BACKSPACE
                      &kp LEFT_GUI  &lt 1 ESCAPE  &kp SPACE  &lt 1 LCTRL  &lt 1 BACKSPACE  &kp ENTER  &kp SPACE  &shift_capsword_capslock
            >;
        };

        lower_layer {
            display-name = "Lower Layer";
            bindings = <
             &trans           &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &kp SLASH     &kp N7        &kp N8        &kp N9        &kp MINUS
&bootloader  &trans           &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT        &kp ASTERISK  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS    &bootloader
&kp TAB      &kp PRINTSCREEN  &kp HOME        &kp PAGE_DOWN   &kp PG_UP     &kp END          &kp COMMA     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &kp BACKSPACE
                              &kp LEFT_GUI    &trans          &kp SPACE     &trans           &trans        &trans        &trans        &trans
            >;
        };

        raise_layer {
            display-name = "Raise Layer";
            bindings = <
        &kp EXCLAMATION  &kp AT_SIGN    &kp HASH  &kp DOLLAR  &kp PERCENT  &kp LCTRL       &kp AMPERSAND  &kp ASTERISK  &kp GRAVE             &trans
&trans  &notEqual        &toRightArrow  &trans    &yankInVim  &https       &kp MINUS       &kp EQUAL      &kp SQT       &kp NON_US_BACKSLASH  &trans        &trans
&trans  &trans           &trans         &trans    &trans      &trans       &kp UNDERSCORE  &kp PLUS       &kp TILDE     &kp PIPE              &kp QUESTION  &trans
                         &trans         &trans    &trans      &trans       &trans          &trans         &trans        &trans
            >;
        };

        layer_3 {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
